{
  "expo": {
    "name": "NEXUS Mobile",
    "slug": "nexus-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "nexus",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0F19"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "local.nexus.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "NEXUS uses the camera to scan secure node pairing QR codes."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0F19"
      },
      "package": "local.nexus.mobile",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "NEXUS needs camera access to scan pairing QR codes from your desktop or server node."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
