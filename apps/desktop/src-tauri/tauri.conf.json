{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NEXUS Desktop",
  "version": "0.1.0",
  "identifier": "local.nexus.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NEXUS",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://nexus-control-plane-uvi8.onrender.com wss://nexus-control-plane-uvi8.onrender.com http://127.0.0.1:8000 ws://127.0.0.1:8000 https://nexus.local:8443 wss://nexus.local:8443; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
