/* --- LIGHT THEME (HIGH CONTRAST) --- */
.theme-light,
.theme-light Screen,
Screen.theme-light {
    background: #f8fafc;
    color: #0f172a;
}

.theme-light #main-body-container,
.theme-light #main-content-switcher {
    background: #f8fafc;
}

.theme-light Label,
.theme-light Static {
    color: #0f172a;
}

