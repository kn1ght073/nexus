/* NEXUS Modern Terminal User Interface Stylesheet */

Screen {
    background: #080c14;
    color: #e2e8f0;
    layout: vertical;
}

/* Header Area */
#nexus-status-header {
    height: 7;
    background: #0d1322;
    border-bottom: solid #0284c7;
    padding: 0 1;
}

.header-top-row {
    height: 3;
    layout: horizontal;
    align: left middle;
}

#nexus-brand {
    width: 28;
    text-style: bold;
    color: #38bdf8;
}

#header-stats {
    width: 1fr;
    layout: horizontal;
    align: right middle;
}

.stat-badge {
    padding: 0 1;
    margin-left: 1;
    background: #1e293b;
    border: none;
    color: #94a3b8;
}

.stat-badge-active {
    padding: 0 1;
    margin-left: 1;
    background: #0369a1;
    color: #ffffff;
    text-style: bold;
}

.stat-badge-online {
    padding: 0 1;
    margin-left: 1;
    background: #14532d;
    color: #4ade80;
    text-style: bold;
}

.stat-badge-degraded {
    padding: 0 1;
    margin-left: 1;
    background: #854d0e;
    color: #fde047;
    text-style: bold;
}

.stat-badge-offline {
    padding: 0 1;
    margin-left: 1;
    background: #7f1d1d;
    color: #f87171;
    text-style: bold;
}

.header-bottom-row {
    height: 3;
    layout: horizontal;
    align: left middle;
    color: #64748b;
}

.header-meta-item {
    margin-right: 3;
}

/* Main Body Layout */
#main-body-container {
    height: 1fr;
    layout: horizontal;
}

/* Navigation Sidebar */
#nav-sidebar {
    width: 32;
    height: 100%;
    background: #0a0f1d;
}

#sidebar-container {
    width: 100%;
    height: 100%;
    background: #0a0f1d;
    border-right: solid #1e293b;
    padding: 1;
}

#sidebar-title {
    text-style: bold;
    color: #38bdf8;
    margin-bottom: 1;
    padding-left: 1;
}

#category-tree {
    height: 1fr;
    background: #0a0f1d;
    border: none;
    scrollbar-size-vertical: 1;
}

/* Central Content Switcher */
#main-content-switcher {
    width: 1fr;
    height: 100%;
    background: #080c14;
}

#view-overview,
#view-account,
#view-devices,
#view-nodes,
#view-network,
#view-sync,
#view-files,
#view-notes-tasks,
#view-services,
#view-diagnostics,
#view-activity,
#view-settings,
#cmd-explorer {
    width: 100%;
    height: 100%;
}

/* Overview Dashboard */
#overview-scroll-container {
    width: 100%;
    height: 100%;
    padding: 1;
}

#overview-welcome-bar {
    height: 3;
    layout: horizontal;
    align: left middle;
    margin-bottom: 1;
    border-bottom: solid #1e293b;
}

#overview-welcome-title {
    text-style: bold;
    color: #38bdf8;
    width: 1fr;
}

#overview-refresh-time {
    color: #64748b;
}

#overview-actions-bar {
    height: 3;
    layout: horizontal;
    align: left middle;
    margin-bottom: 1;
}

.btn-quick-act {
    margin-right: 1;
    height: 3;
    min-width: 14;
    background: #1e293b;
    color: #38bdf8;
    border: none;
    text-style: bold;
}

.btn-quick-act:hover {
    background: #0284c7;
    color: #ffffff;
}

.overview-cards-row {
    height: auto;
    min-height: 11;
    layout: horizontal;
    margin-bottom: 1;
}

.overview-card {
    width: 1fr;
    height: auto;
    min-height: 11;
    background: #0f172a;
    border: solid #1e293b;
    padding: 1;
    margin-right: 1;
}

.overview-card:last-child {
    margin-right: 0;
}

.overview-full-card {
    width: 100%;
    height: auto;
    background: #0f172a;
    border: solid #1e293b;
    padding: 1;
    margin-bottom: 1;
}

.card-header {
    text-style: bold;
    color: #38bdf8;
    border-bottom: solid #1e293b;
    margin-bottom: 1;
    padding-bottom: 0;
}

.card-header-row {
    height: 3;
    layout: horizontal;
    align: left middle;
    margin-bottom: 1;
}

.card-body {
    height: auto;
    color: #e2e8f0;
}

.btn-sm {
    height: 3;
    padding: 0 1;
    margin-left: 1;
    min-width: 10;
    border: none;
    background: #1e293b;
    color: #e2e8f0;
}

.btn-sm:hover {
    background: #0284c7;
    color: #ffffff;
}

Button.-warning {
    color: #080c14;
    text-style: bold;
}

Button.-success {
    color: #080c14;
    text-style: bold;
}

/* Generic View Headers */
.view-header-bar {
    height: 3;
    layout: horizontal;
    align: left middle;
    margin-bottom: 1;
    border-bottom: solid #1e293b;
}

.view-title {
    text-style: bold;
    color: #38bdf8;
    width: 1fr;
}

.header-actions {
    layout: horizontal;
    align: right middle;
    width: auto;
}

.details-row {
    height: auto;
    layout: horizontal;
    margin-bottom: 1;
}

.details-box {
    width: 1fr;
    background: #0f172a;
    border: solid #1e293b;
    padding: 1;
    margin-right: 1;
}

.details-box:last-child {
    margin-right: 0;
}

.box-title {
    text-style: bold;
    color: #38bdf8;
    margin-bottom: 1;
    border-bottom: solid #1e293b;
}

.config-bar {
    height: 3;
    layout: horizontal;
    align: left middle;
    margin-bottom: 1;
    padding: 0 1;
    background: #0d1322;
    border: solid #1e293b;
}

.config-label {
    width: 1fr;
    color: #94a3b8;
}

.ascii-diagram {
    color: #38bdf8;
    padding: 1;
    background: #0b1120;
    border: solid #1e293b;
}

/* Domain Views Containers */
#account-scroll-container,
#network-scroll-container,
#sync-scroll-container,
#services-scroll-container,
#settings-scroll-container {
    width: 100%;
    height: 100%;
    padding: 1;
}

#unauth-account-container {
    width: 100%;
    height: auto;
    background: #0d1527;
    border: solid #1e293b;
    padding: 1 2;
    margin-bottom: 1;
}

#unauth-desc-static {
    color: #94a3b8;
    margin: 1 0;
}

#unauth-actions-row {
    width: 100%;
    height: 3;
    margin-top: 1;
}

#unauth-actions-row Button {
    margin-right: 2;
}

#auth-account-container {
    width: 100%;
    height: auto;
}

#devices-container,
#nodes-container,
#files-container,
#productivity-container,
#diagnostics-container,
#activity-container {
    width: 100%;
    height: 100%;
    padding: 1;
}

#devices-split-body,
#nodes-split-body,
#files-dual-pane,
#activity-split-body,
#diagnostics-split-body {
    height: 1fr;
    layout: horizontal;
}

#devices-table-container,
#nodes-table-container,
#files-list-pane,
#activity-table-container,
#diag-table-container {
    width: 1fr;
    height: 100%;
    margin-right: 1;
}

#device-details-card,
#node-details-card,
#files-preview-pane,
#activity-details-card,
#diag-details-card {
    width: 38;
    height: 100%;
}

#device-action-buttons,
#node-action-buttons,
#files-action-buttons,
#activity-action-buttons,
#diag-action-buttons {
    height: 3;
    layout: horizontal;
    align: right middle;
    margin-top: 1;
}

#files-breadcrumb-bar {
    height: 3;
    layout: horizontal;
    align: left middle;
    background: #0d1322;
    border: solid #1e293b;
    padding: 0 1;
    margin-bottom: 1;
}

.breadcrumb-label {
    color: #64748b;
    margin-right: 1;
}

#files-breadcrumb-path {
    color: #38bdf8;
    text-style: bold;
}

/* Kanban Board for Notes & Tasks */
#kanban-action-bar,
#notes-action-bar,
#projects-action-bar {
    height: 3;
    layout: horizontal;
    align: left middle;
    margin-bottom: 1;
}

.kanban-section-title {
    width: 1fr;
    text-style: bold;
    color: #94a3b8;
}

#kanban-columns-container {
    height: 1fr;
    min-height: 24;
    layout: horizontal;
    margin-bottom: 1;
}

.kanban-column {
    width: 1fr;
    height: 100%;
    background: #0b1120;
    border: solid #1e293b;
    padding: 1;
    margin-right: 1;
}

.kanban-column:last-child {
    margin-right: 0;
}

.kanban-col-header {
    text-style: bold;
    text-align: center;
    color: #38bdf8;
    border-bottom: solid #1e293b;
    margin-bottom: 1;
    padding-bottom: 0;
}

.kanban-cards-area {
    height: 1fr;
    overflow-y: auto;
}

#notes-cards-container {
    height: auto;
    min-height: 20;
    padding: 1;
    background: #0b1120;
    border: solid #1e293b;
}

#projects-table-container {
    height: 1fr;
    min-height: 20;
}

/* Settings Controls */
.btn-group-row {
    height: 3;
    layout: horizontal;
    align: left middle;
    margin-bottom: 1;
}

.form-inline-row {
    height: 3;
    layout: horizontal;
    align: left middle;
    margin-top: 1;
}

.form-inline-row Input {
    width: 1fr;
    margin-right: 1;
}

/* Explorer Panel */
#explorer-container {
    width: 1fr;
    height: 100%;
    background: #090d18;
    padding: 1;
    border-right: solid #1e293b;
}

#explorer-header-row {
    height: 3;
    layout: horizontal;
    align: left middle;
    margin-bottom: 1;
}

#explorer-title {
    width: 25;
    text-style: bold;
    color: #38bdf8;
}

#command-filter-input {
    width: 1fr;
    background: #111827;
    border: solid #1e293b;
    color: #e2e8f0;
}

#command-filter-input:focus {
    border: solid #38bdf8;
}

#commands-table,
#overview-activity-table,
#account-sessions-table,
#devices-table,
#nodes-table,
#relay-links-table,
#sync-devices-table,
#files-table,
#projects-table,
#diagnostics-table,
#activity-table {
    height: 1fr;
    background: #090d18;
    border: solid #1e293b;
}

/* Context Panel */
#ctx-panel {
    width: 38;
    height: 100%;
    background: #0b1120;
}

#context-container {
    width: 100%;
    height: 100%;
    background: #0b1120;
    border-left: solid #1e293b;
    padding: 1 2;
}

#context-title {
    text-style: bold;
    color: #38bdf8;
    margin-bottom: 1;
}

#context-content {
    height: 1fr;
    overflow-y: auto;
}

#context-actions {
    height: 4;
    layout: horizontal;
    align: center middle;
    margin-top: 1;
}

.btn-execute {
    background: #0284c7;
    color: #ffffff;
    text-style: bold;
    border: none;
    width: 100%;
}

.btn-execute:hover {
    background: #0369a1;
}

.btn-destructive {
    background: #b91c1c;
    color: #ffffff;
    text-style: bold;
    border: none;
    width: 100%;
}

.btn-destructive:hover {
    background: #991b1b;
}

/* Modals */
ModalScreen {
    align: center middle;
    background: rgba(0, 0, 0, 0.75);
}

.modal-box {
    width: 72;
    height: auto;
    max-height: 85%;
    background: #0f172a;
    border: solid #0284c7;
    padding: 1 2;
}

.modal-header {
    text-style: bold;
    color: #38bdf8;
    margin-bottom: 1;
    text-align: center;
}

.modal-footer {
    height: 3;
    layout: horizontal;
    align: right middle;
    margin-top: 1;
}

.modal-button {
    margin-left: 1;
}

/* Command Palette */
#palette-box {
    width: 76;
    height: 22;
    background: #0d1322;
    border: solid #38bdf8;
    padding: 1 2;
}

#palette-search-input {
    background: #111827;
    border: solid #0284c7;
    margin-bottom: 1;
}

#palette-results-list {
    height: 14;
    background: #0d1322;
    border: none;
}

#profiles-option-list {
    height: 6;
    min-height: 4;
    background: #0d1322;
    border: solid #1e293b;
    margin-bottom: 1;
}

/* Footer Keymap */
Footer {
    background: #0a0f1d;
    color: #64748b;
    border-top: solid #1e293b;
}

/* Themes */

/* --- DARK THEME (DEFAULT) --- */
.theme-dark,
.theme-dark Screen,
Screen.theme-dark {
    background: #080c14;
    color: #e2e8f0;
}

.theme-dark #main-body-container,
.theme-dark #main-content-switcher {
    background: #080c14;
}

.theme-dark #nexus-status-header {
    background: #0d1322;
    border-bottom: solid #0284c7;
    color: #e2e8f0;
}

.theme-dark #nexus-brand,
.theme-dark .view-title,
.theme-dark .card-header,
.theme-dark .box-title {
    color: #38bdf8;
}

.theme-dark .overview-card,
.theme-dark .overview-full-card,
.theme-dark .details-box {
    background: #0f172a;
    border: solid #1e293b;
    color: #e2e8f0;
}

.theme-dark .config-bar {
    background: #0d1322;
    border: solid #1e293b;
}

.theme-dark .config-label,
.theme-dark .config-bar Label {
    color: #94a3b8;
}

.theme-dark #nav-sidebar,
.theme-dark #sidebar-container,
.theme-dark #category-tree,
.theme-dark Tree {
    background: #0a0f1d;
    color: #e2e8f0;
}

.theme-dark Tree > .tree--guides {
    color: #1e293b;
}

.theme-dark Tree > .tree--cursor,
.theme-dark Tree:focus > .tree--cursor {
    background: #0369a1;
    color: #ffffff;
    text-style: bold;
}

.theme-dark Tree > .tree--highlight {
    background: #1e293b;
    color: #38bdf8;
}

.theme-dark #ctx-panel,
.theme-dark #context-container {
    background: #0b1120;
    border-left: solid #1e293b;
    color: #e2e8f0;
}

.theme-dark Input,
.theme-dark #command-filter-input,
.theme-dark #new-profile-name,
.theme-dark #new-profile-url,
.theme-dark #notes-search-input,
.theme-dark #palette-search-input {
    background: #111827;
    border: solid #1e293b;
    color: #e2e8f0;
}

.theme-dark Input > .input--placeholder {
    color: #64748b;
}

.theme-dark Input > .input--cursor {
    background: #38bdf8;
    color: #080c14;
}

.theme-dark Switch {
    background: #111827;
    color: #e2e8f0;
    border: tall #1e293b;
}

.theme-dark Switch > .switch--slider {
    color: #94a3b8;
    background: #1e293b;
}

.theme-dark Switch.-on {
    background: #0f172a;
    border: tall #0284c7;
}

.theme-dark Switch.-on > .switch--slider {
    color: #38bdf8;
    background: #0284c7;
}

.theme-dark Switch:focus {
    border: tall #38bdf8;
}

.theme-dark DataTable,
.theme-dark #commands-table,
.theme-dark #overview-activity-table,
.theme-dark #account-sessions-table,
.theme-dark #devices-table,
.theme-dark #nodes-table,
.theme-dark #relay-links-table,
.theme-dark #sync-devices-table,
.theme-dark #files-table,
.theme-dark #projects-table,
.theme-dark #diagnostics-table,
.theme-dark #activity-table,
.theme-dark #profiles-table {
    background: #090d18;
    border: solid #1e293b;
    color: #e2e8f0;
}

.theme-dark DataTable > .datatable--header {
    background: #0f172a;
    color: #38bdf8;
    text-style: bold;
}

.theme-dark DataTable > .datatable--cursor {
    background: #0369a1;
    color: #ffffff;
    text-style: bold;
}

.theme-dark DataTable > .datatable--hover {
    background: #1e293b;
}

.theme-dark .btn-sm,
.theme-dark .btn-quick-act {
    background: #1e293b;
    color: #38bdf8;
    border: none;
}

.theme-dark .btn-sm:hover,
.theme-dark .btn-quick-act:hover {
    background: #0284c7;
    color: #ffffff;
}

.theme-dark .modal-box,
.theme-dark #palette-box {
    background: #0f172a;
    border: solid #0284c7;
    color: #e2e8f0;
}

.theme-dark #palette-results-list,
.theme-dark #profiles-option-list,
.theme-dark #settings-profile-list,
.theme-dark OptionList {
    background: #0d1322;
    color: #e2e8f0;
    border: solid #1e293b;
}

.theme-dark OptionList > .option-list--option-highlighted,
.theme-dark OptionList:focus > .option-list--option-highlighted {
    background: #0369a1;
    color: #ffffff;
    text-style: bold;
}

.theme-dark OptionList > .option-list--option-hover {
    background: #1e293b;
}

.theme-dark Toast {
    background: #0f172a;
    border: solid #0284c7;
    color: #e2e8f0;
}

.theme-dark Toast.-information {
    border-left: outer #22c55e;
}

.theme-dark Toast.-warning {
    border-left: outer #eab308;
}

.theme-dark Toast.-error {
    border-left: outer #ef4444;
}

.theme-dark Footer {
    background: #0a0f1d;
    color: #64748b;
    border-top: solid #1e293b;
}

/* --- SYNTHWAVE THEME --- */
.theme-synthwave,
.theme-synthwave Screen,
Screen.theme-synthwave {
    background: #18002e;
    color: #ff71ce;
}

.theme-synthwave #main-body-container,
.theme-synthwave #main-content-switcher {
    background: #18002e;
}

.theme-synthwave Label,
.theme-synthwave Static {
    color: #ff71ce;
}

.theme-synthwave #nexus-brand,
.theme-synthwave .view-title,
.theme-synthwave .card-header,
.theme-synthwave .box-title,
.theme-synthwave #sidebar-title,
.theme-synthwave #context-title,
.theme-synthwave #overview-welcome-title,
.theme-synthwave #explorer-title,
.theme-synthwave .modal-header,
.theme-synthwave .toast--title,
.theme-synthwave .kanban-col-header {
    color: #01cdfe;
}

.theme-synthwave #nexus-status-header {
    background: #240046;
    border-bottom: solid #01cdfe;
    color: #ff71ce;
}

.theme-synthwave .header-top-row,
.theme-synthwave .header-bottom-row,
.theme-synthwave .card-body,
.theme-synthwave #context-content {
    color: #ff71ce;
}

.theme-synthwave .stat-badge {
    background: #3c096c;
    color: #ff71ce;
    border: none;
}

.theme-synthwave .stat-badge-active {
    background: #7b2cbf;
    color: #05ffa1;
    text-style: bold;
}

.theme-synthwave .stat-badge-online {
    background: #05ffa1;
    color: #18002e;
    text-style: bold;
}

.theme-synthwave .stat-badge-degraded {
    background: #fffb96;
    color: #18002e;
    text-style: bold;
}

.theme-synthwave .stat-badge-offline {
    background: #ff2a85;
    color: #ffffff;
    text-style: bold;
}

.theme-synthwave #nav-sidebar {
    background: #240046;
}

.theme-synthwave #sidebar-container {
    background: #240046;
    border-right: solid #7b2cbf;
    color: #ff71ce;
}

.theme-synthwave #category-tree,
.theme-synthwave Tree {
    background: #240046;
    color: #ff71ce;
    border: none;
}

.theme-synthwave Tree > .tree--label {
    color: #ff71ce;
}

.theme-synthwave Tree > .tree--guides {
    color: #7b2cbf;
}

.theme-synthwave Tree > .tree--cursor,
.theme-synthwave Tree:focus > .tree--cursor {
    background: #7b2cbf;
    color: #05ffa1;
    text-style: bold;
}

.theme-synthwave Tree > .tree--highlight {
    background: #3c096c;
    color: #01cdfe;
}

.theme-synthwave #ctx-panel {
    background: #240046;
}

.theme-synthwave #context-container {
    background: #240046;
    border-left: solid #7b2cbf;
    color: #ff71ce;
}

.theme-synthwave .overview-card,
.theme-synthwave .overview-full-card,
.theme-synthwave .details-box,
.theme-synthwave #unauth-account-container,
.theme-synthwave .kanban-column,
.theme-synthwave #notes-cards-container {
    background: #2b0c48;
    border: solid #05ffa1;
    color: #ff71ce;
}

.theme-synthwave .card-header,
.theme-synthwave .box-title,
.theme-synthwave .view-header-bar,
.theme-synthwave #overview-welcome-bar,
.theme-synthwave .kanban-col-header {
    border-bottom: solid #7b2cbf;
}

.theme-synthwave .config-bar,
.theme-synthwave #files-breadcrumb-bar {
    background: #240046;
    border: solid #7b2cbf;
    color: #ff71ce;
}

.theme-synthwave .config-label,
.theme-synthwave .config-bar Label,
.theme-synthwave .breadcrumb-label {
    color: #01cdfe;
}

.theme-synthwave #files-breadcrumb-path {
    color: #05ffa1;
}

.theme-synthwave .ascii-diagram {
    background: #240046;
    border: solid #01cdfe;
    color: #05ffa1;
}

.theme-synthwave #explorer-container {
    background: #18002e;
    border-right: solid #7b2cbf;
    color: #ff71ce;
}

.theme-synthwave Input,
.theme-synthwave #command-filter-input,
.theme-synthwave #new-profile-name,
.theme-synthwave #new-profile-url,
.theme-synthwave #notes-search-input,
.theme-synthwave #palette-search-input {
    background: #2b0c48;
