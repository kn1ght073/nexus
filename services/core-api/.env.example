# NEXUS control plane — self-hosted environment (docker compose).
# Copy to .env, fill the values, then: docker compose up -d

# 64-hex secret; generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
NEXUS_JWT_SECRET=change-me-to-a-random-64-hex-string

# Postgres inside the compose network; pick a strong password.
POSTGRES_PASSWORD=change-me-too
NEXUS_DATABASE_URL=postgresql://nexus:change-me-too@postgres:5432/nexus

# Where the API is served (Caddy puts TLS in front). List your client
# origins if you host a web dashboard later.
NEXUS_CORS_ORIGINS=["https://your-domain.example.com"]

# The DNS name that points at this server (A/AAAA record). Caddy gets a
# Let's Encrypt certificate automatically. Leave empty and remove the
# caddy service to serve plain HTTP on :8000 for LAN-only testing.
CADDY_DOMAIN=your-domain.example.com
